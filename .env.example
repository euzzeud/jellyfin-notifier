# Compte Gmail existant (celui qui envoie déjà les alertes Grafana)
GMAIL_ADDRESS=gioielli.supervision@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
SENDER_NAME=Jellyfin

# Destinataire(s), séparés par des virgules
NOTIFY_RECIPIENTS=maman@example.com

# Jellyfin (pour récupérer l'affiche du contenu ajouté, utilisée pour les appels API - doit rester joignable)
JELLYFIN_URL=http://192.168.1.22:8096
JELLYFIN_API_KEY=

# URL utilisée UNIQUEMENT pour le lien "Regarder" cliquable dans le mail
# (peut être un nom de domaine local différent de JELLYFIN_URL). Optionnel :
# si absent, reprend JELLYFIN_URL.
JELLYFIN_PUBLIC_URL=http://jellyfin.gioielli

# Attend 5 min après le dernier ajout avant d'envoyer le digest
# (évite un mail par épisode quand on ajoute une saison complète)
DEBOUNCE_SECONDS=300

# Types d'items déclenchant une notif (Movie, Series, Season, Episode)
NOTIFY_ITEM_TYPES=Movie,Series

# Optionnel : secret partagé pour sécuriser l'endpoint webhook
WEBHOOK_SHARED_SECRET=
PORT=5005

# Polling de l'API Jellyfin (remplace le webhook, plus fiable) :
# vérifie les nouveaux items toutes les POLL_INTERVAL_SECONDS.
POLLER_ENABLED=true
POLL_INTERVAL_SECONDS=300
SEEN_ITEMS_PATH=seen_items.json

# Interface d'admin web, accessible sur http://<ip-du-lxc>:5005/admin
# (planning, éditeur de template, console API, gestion du service, logs).
# Protégée par mot de passe simple (HTTP Basic Auth) - pensée pour un accès
# LAN uniquement, ne pas exposer sur internet sans HTTPS devant.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi

# Fichiers de données de l'admin (planning, file d'attente, titres à venir)
SETTINGS_PATH=settings.json
PENDING_ITEMS_PATH=pending_items.json
UPCOMING_PATH=upcoming.json
